DATABASE_URL=postgres://localhost:5432/locali
# AI concierge: set ONE of these. Gemini has a free tier (aistudio.google.com).
GEMINI_API_KEY=
# Optional, auto-detected if empty: GEMINI_MODELS=gemini-x-flash,gemini-x-flash-lite
ANTHROPIC_API_KEY=
# Optional: without it the app runs on the built-in demo dataset (Kyiv)
GOOGLE_PLACES_API_KEY=
# Optional, Claude model when ANTHROPIC_API_KEY is used
CONCIERGE_MODEL=claude-opus-5-5
